# Settings for hummer-battery.service.
# Install to /etc/default/hummer-battery.
#
# Cell voltage at or below which the node shuts down.  A PiSugar2 lithium cell
# is nominally 3.7 V and its converter cuts off near 3.0 V, so 3.40 V leaves
# real headroom to close SQLite and flush the raw log before power goes.
BATTERY_SHUTDOWN_V=3.40

# Seconds between readings.
BATTERY_INTERVAL_S=30

# Consecutive low readings required before acting.  One low reading is noise;
# five of them 30 s apart is two minutes of sustained evidence.  A shutdown
# that fires wrongly leaves the node dead until somebody walks out to it, so
# the bias is deliberately towards waiting.
BATTERY_CONSECUTIVE=5

# What to do when the cell is genuinely low.
#
# stop-collector (default) ends vehicle polling -- the thing actually drawing
# power and holding the serial port -- and leaves the node up and reachable. A
# node you can still talk to can be told what to do next.
#
# poweroff halts the OS, and on a PiSugar2 that STRANDS the node: this hardware
# cannot power itself back on. The vendor's own library implements
# toggle_power_restore for the PiSugar 3 and returns "not supported" for the
# IP5209, and the documented way to restore output is to toggle the physical
# switch by hand. Do not set this without solving the return first.
BATTERY_EXTRA=--on-low stop-collector
